{
    "ci": {
        "collect": {
            "startServerCommand": "npm run start",
            "url": [
                "http://localhost:3000/"
            ],
            "numberOfRuns": 3
        },
        "assert": {
            "assertions": {
                "categories:performance": [
                    "error",
                    {
                        "minScore": 0.9
                    }
                ],
                "largest-contentful-paint": [
                    "error",
                    {
                        "maxNumericValue": 2500
                    }
                ],
                "interactive": [
                    "error",
                    {
                        "maxNumericValue": 3000
                    }
                ]
            }
        }
    }
}